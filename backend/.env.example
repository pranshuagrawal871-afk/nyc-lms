SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=
# PostgreSQL TLS. Production verifies certificates unless this is explicitly false.
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=
# DB_SSL=false
# Replaced lesson files are deleted only after this many hours. Default 24.
# MEDIA_RETENTION_HOURS=24
# Signed playback URLs stay valid for this many seconds (60-3600). Default 3600.
# A password change rejects new stream tokens immediately. An already issued
# storage URL cannot be revoked before this window ends.
# STREAM_URL_TTL_SECONDS=3600

